# Generation model (anthropic | openai | openrouter | ollama)
# OpenRouter model ids are prefixed, e.g. anthropic/claude-haiku-5-5 (check openrouter.ai/models)
LLM_PROVIDER=ollama
LLM_MODEL=hf.co/Qwen/Qwen3-8B-GGUF:Q4_K_M
# Evaluation judge (RAGAS). Use a different family than the generator if possible.
# Small local judges give low-reliability RAGAS scores (labelled as such in results).
JUDGE_PROVIDER=ollama
JUDGE_MODEL=hf.co/Qwen/Qwen3-8B-GGUF:Q4_K_M

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ollama needs no key; set OLLAMA_BASE_URL if not localhost
# OLLAMA_BASE_URL=http://localhost:11434

# Qdrant: local file mode by default; set VECTOR_STORE_MODE=server to use QDRANT_URL
VECTOR_STORE_MODE=local
QDRANT_URL=http://localhost:6333
